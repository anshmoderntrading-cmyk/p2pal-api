{
  "expo": {
    "name": "P2Pal",
    "slug": "p2pal",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#10141C",
    "ios": {
      "bundleIdentifier": "com.p2pal.wallet",
      "infoPlist": {
        "NSFaceIDUsageDescription": "P2Pal wallet unlock aur transaction confirm karne ke liye Face ID use karta hai.",
        "NSCameraUsageDescription": "Wallet address ka QR code scan karne ke liye camera chahiye."
      }
    },
    "android": {
      "package": "com.p2pal.wallet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "P2Pal unlock karne ke liye Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "QR code scan karne ke liye camera chahiye."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#000000",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}