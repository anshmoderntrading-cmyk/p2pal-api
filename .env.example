# --- Gasless USDT (required) ---
# 12-word phrase of a NEW wallet used ONLY for network fees. Fund it with TRX + BNB.
TREASURY_MNEMONIC=
# Optional: send collected USDT fees somewhere else (defaults to the treasury addresses)
FEE_ADDRESS_TRON=
FEE_ADDRESS_BSC=

# --- Fee policy ---
FEE_MARGIN_PCT=25
FEE_FLAT_TRC20=0.5
FEE_FLAT_BEP20=0.1
MIN_FEE_TRC20=1
MIN_FEE_BEP20=0.2

# --- Safety limits ---
MAX_TOPUP_TRX=60
MAX_TOPUP_BNB=0.003
DAILY_TOPUPS_PER_ADDRESS=8
TREASURY_DAILY_BUDGET_USD=50

# --- Data providers ---
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
BSC_RPC=https://bsc-dataseed.bnbchain.org
POLL_SECONDS=60
